# Copy to .env for local dev. NEVER commit a real secret.
# HMAC_SECRET comes from the zkVerify dashboard at agent registration
# (32-byte secret, shown exactly once). Each agent gets its OWN secret —
# do NOT reuse the Proof Gatekeeper secret.
HMAC_SECRET=

# Steal the VFY strategy. Params are the 8 committed thresholds; the salt
# is the private randomness in the Poseidon commitment. The commitment hash
# printed by `npm run commitment` is what gets registered on the dashboard.
# Change EITHER value only BEFORE registering — after registration the
# commitment is frozen; changing params/salt afterwards breaks every proof.
# STEAL_VFY_PARAMS=8,18,8,0,0,0,0,0
# STEAL_VFY_SALT=

# Optional: GitHub-file turn-response persistence (Vercel path). Local dev
# uses the gh CLI auth instead. Leave unset to run in-memory only.
# GITHUB_TOKEN=

# Optional overrides (defaults: STORE_REPO=faaz12/zkverify-steal-the-vfy,
# STORE_FILE=data/turns.jsonl, STORE_BACKEND=github, STORE_BRANCH=main)
# STORE_BACKEND=memory
# STORE_FILE=data/turns.jsonl
# PROVE_TIMEOUT_MS=10000
